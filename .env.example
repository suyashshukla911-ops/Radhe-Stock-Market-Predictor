# Radhe Stock Market Predictor
APP_NAME=Radhe Stock Market Predictor
APP_BASE_URL=http://localhost:8000

# Upstox Analytics Token / OAuth fallback
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback

# FreeNewsApi.io (x-api-key header)
NEWS_API_KEY=
NEWS_PROVIDER=freenewsapi
NEWS_DAILY_QUOTA=5000
NEWS_MIN_INTERVAL_SECONDS=4.5
NEWS_WINDOW_SECONDS=5

# Realtime behavior
LIVE_POLL_SECONDS=1
PREDICTION_REFRESH_SECONDS=30
WATCH_REFRESH_SECONDS=15
MODEL_RETRAIN_MINUTES=30

# Training windows
TRAIN_DAYS_SHORT=30
TRAIN_DAYS_LONG=90
MIN_TRAIN_ROWS=300
CHART_BARS=180
